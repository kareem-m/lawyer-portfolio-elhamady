datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Article {
  id        String   @id @default(cuid())
  slug      String   @unique
  titleAr   String
  titleEn   String
  contentAr String   @db.Text
  contentEn String   @db.Text
  image     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}